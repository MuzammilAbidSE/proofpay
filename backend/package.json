{
  "name": "proofpay-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ProofPay NestJS API: application data, indexing, notifications, off-chain metadata",
  "main": "dist/main.js",
  "scripts": {
    "prisma": "node node_modules/prisma/build/index.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node -r ts-node/register src/main.ts",
    "test": "node -r ts-node/register node_modules/mocha/bin/_mocha --require ts-node/register 'test/**/*.spec.ts'"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ethers": "^6.13.4",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
